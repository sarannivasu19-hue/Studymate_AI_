# Database connection (Either DATABASE_URL or individual DB_* variables)
# On Render / cloud, set DATABASE_URL (e.g. mysql+pymysql://user:pass@host:3306/dbname)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=studymate
DB_SSL=false

# JWT Authentication
JWT_SECRET_KEY=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Frontend origin allowed for CORS (comma-separated for multiple origins)
FRONTEND_ORIGIN=https://studymate-frontend-4qh0.onrender.com,http://localhost:5173

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Server Port (automatically set by Render)
PORT=8000
